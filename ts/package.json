{
	"name": "strictspec",
	"version": "0.4.0",
	"license": "MIT",
	"type": "module",
	"description": "Define a schema once in TOML, and generate the full toolchain in your language: validation, versioning, migrations, etc. -- First-class support for Go, Python, and TypeScript",
	"homepage": "https://smmh.dev/strictspec/",
	"bugs": {
		"url": "https://github.com/stricttools/strictspec/issues"
	},
	"bin": {
		"strictspec": "bin/strictspec.cjs"
	},
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stricttools/strictspec.git",
		"directory": "ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"bin"
	],
	"scripts": {
		"gencodes": "node scripts/gencodes.mjs",
		"build": "tsc",
		"test": "npm run build && tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
		"lint": "biome check .",
		"prepack": "npm run build"
	},
	"dependencies": {
		"toml-eslint-parser": "^1.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@types/node": "^22.20.1",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"strictspec",
		"schema",
		"codegen",
		"validation",
		"toml",
		"rlsbl"
	]
}
