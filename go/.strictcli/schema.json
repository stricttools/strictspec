  "project_id": "github.com/smm-h/strictspec/go",
  "name": "strictspec",
  "version": "0.1.0",
  "help": "strictspec: strict, byte-identical schema validation and code generation",
  "commands": {
    "gen": {
      "name": "gen",
      "help": "Generate validator code from the manifest (strictspec.toml)",
      "effect": "mutating",
      "flags": [
        {
          "name": "manifest",
          "help": "Path to the strictspec.toml manifest; omitted means strictspec.toml",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        }
      ]
    },
    "validate": {
      "name": "validate",
      "help": "Validate document(s) against a schema and render diagnostics",
      "effect": "read_only",
      "flags": [
        {
          "name": "mode",
          "help": "Which check phases to run",
          "presence": "required",
          "choices": [
            {
              "name": "structural-only",
              "help": "Run phase-1 structural checks only"
            },
            {
              "name": "with-domain-checks",
              "help": "Also run the phase-2 constraint vocabulary",
              "flags": [
                {
                  "name": "collection",
                  "help": "Glob hosting an in-process documents-in(...) evidence collection (repeatable)",
                  "value_schema": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "presence": "optional"
                },
                {
                  "name": "collection-root",
                  "help": "Root the --collection globs are anchored at",
                  "value_schema": {
                    "type": "string"
                  },
                  "presence": "default",
                  "default": "."
                }
              ]
            }
          ],
          "elect_by": "member-flags"
        }
      ],
      "args": [
        {
          "name": "schema",
          "help": "Path to the schema file",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        },
        {
          "name": "documents",
          "help": "One or more document files to validate",
          "value_schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "presence": "required",
          "variadic": true
        }
      ]
    },
    "check": {
      "name": "check",
      "help": "Check schema authoring validity and generated-code freshness",
      "effect": "read_only",
      "flags": [
        {
          "name": "manifest",
          "help": "Path to the strictspec.toml manifest",
          "value_schema": {
            "type": "string"
          },
          "presence": "default",
          "default": "strictspec.toml"
        }
      ]
    },
    "init": {
      "name": "init",
      "help": "Scaffold a minimal strictspec.toml manifest and .gitattributes",
      "effect": "mutating",
      "flags": [
        {
          "name": "manifest",
          "help": "Path to the strictspec.toml manifest to create; omitted means strictspec.toml",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        }
      ]
    },
    "export": {
      "name": "export",
      "help": "Export a schema to JSON Schema (advisory; lossy per the constitution)",
      "effect": "mutating",
      "flags": [
        {
          "name": "output",
          "help": "Output path; omitted means stdout",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        }
      ],
      "args": [
        {
          "name": "schema",
          "help": "Path to the schema file",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        }
      ]
    },
    "migrate": {
      "name": "migrate",
      "help": "Migrate document(s) up to the schema's current format_version",
      "effect": "mutating",
      "flags": [
        {
          "name": "to",
          "help": "Target format_version (must equal the schema's current format_version)",
          "value_schema": {
            "type": "integer"
          },
          "presence": "required"
        },
        {
          "name": "migrations",
          "help": "Directory of *.migration.toml files forming the chain; omitted means the current directory",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        }
      ],
      "args": [
        {
          "name": "schema",
          "help": "Path to the target (current-version) schema file",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        },
        {
          "name": "documents",
          "help": "One or more document files to migrate",
          "value_schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "presence": "required",
          "variadic": true
        }
      ]
    },
    "diff": {
      "name": "diff",
      "help": "Compare a schema at two format_versions over a corpus; emit a certificate",
      "effect": "read_only",
      "flags": [
        {
          "name": "corpus",
          "help": "Corpus glob (anchored at --corpus-root, lexicographic)",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        },
        {
          "name": "corpus-root",
          "help": "Root the corpus glob is anchored at",
          "value_schema": {
            "type": "string"
          },
          "presence": "default",
          "default": "."
        },
        {
          "name": "migration",
          "help": "Path to the migration file between the two versions",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        },
        {
          "name": "adjudication",
          "help": "Path to a committed adjudication file to acknowledge",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        },
        {
          "name": "same-version",
          "help": "Force same-version narrowing scan (no migration)",
          "value_schema": {
            "type": "boolean"
          },
          "presence": "default",
          "default": false,
          "negatable": true
        }
      ],
      "args": [
        {
          "name": "old-schema",
          "help": "Path to the schema at format_version N",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        },
        {
          "name": "new-schema",
          "help": "Path to the schema at format_version N+1",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        }
      ]
    },
    "doc-diff": {
      "name": "doc-diff",
      "help": "Structural per-path delta of two documents of one schema",
      "effect": "read_only",
      "args": [
        {
          "name": "schema",
          "help": "Path to the schema file",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        },
        {
          "name": "old-document",
          "help": "Path to the OLD document",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        },
        {
          "name": "new-document",
          "help": "Path to the NEW document",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        }
      ]
    }
  }
}
