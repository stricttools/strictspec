{
  "width": 320,
  "height": 240.0,
  "background": "$bg",
  "styles": {
    "bg": { "light": "#ffffff", "dark": "#101010" }
  },
  "elements": [
    { "type": "background", "fill": "$bg" },
    {
      "type": "rect", "id": "box", "x": 10, "y": 10, "width": 100, "height": 50,
      "fill": { "type": "linear-gradient", "stops": [
        { "offset": 0, "color": "#ff0000" },
        { "offset": 1, "color": "#0000ff", "opacity": 0.5 }
      ], "angle": 45 },
      "stroke": "#000000", "strokeWidth": 2,
      "transform": { "translate": [5, 5], "scale": [1.0, 1.0] }
    },
    {
      "type": "group", "id": "wrap",
      "elements": [
        { "type": "text", "content": "hi", "x": 0, "y": 0, "font": { "family": "Inter", "size": 14, "weight": 600 } }
      ]
    }
  ],
  "pipeline": [
    { "action": "center", "target": "box", "axis": "both" },
    { "action": "place", "target": "wrap", "below": "box", "gap": 8 }
  ]
}
